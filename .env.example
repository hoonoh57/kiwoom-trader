# Copy to .env and fill in real values. Never commit .env.

# 1 = 모의투자(mockapi.kiwoom.com), 0 = 실전(api.kiwoom.com)
KIWOOM_USE_PAPER=1

# 모의투자 키
KIWOOM_MOCK_APPKEY=
KIWOOM_MOCK_SECRETKEY=

# 실전 키
KIWOOM_REAL_APPKEY=
KIWOOM_REAL_SECRETKEY=

# 계좌번호 (ARM 확인에 끝 4자리 사용)
KIWOOM_ACCOUNT=

# Server (127.0.0.1 고정 권장)
HOST=127.0.0.1
PORT=8077

LOG_LEVEL=INFO

# Notifications (optional, notifier 애드온 전용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
